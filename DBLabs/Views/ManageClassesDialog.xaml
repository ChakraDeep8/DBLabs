<Window x:Class="DBLabs.Views.ManageClassesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage Calibration Classes" Height="560" Width="640" MinHeight="380" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackground}" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="CALIBRATION CLASSES" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="+ Add Class" Click="AddClass_Click" Style="{StaticResource PrimaryButton}"/>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBackground}" CornerRadius="8">
            <Grid>
                <TextBlock x:Name="EmptyStateText" Text="No calibration classes yet.&#x0a;Classes let you reuse common ROI names instead of typing them every time."
                           Foreground="{StaticResource TextSecondary}" FontSize="12.5" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320" Visibility="Collapsed"/>
                <ListBox x:Name="ClassList" Background="Transparent" BorderThickness="0" Margin="8"
                         ItemContainerStyle="{StaticResource ObjectListItem}" SelectionChanged="ClassList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="14" Height="14" Fill="{Binding SwatchBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding ShapeLabel}" Foreground="{StaticResource TextSecondary}" FontSize="11.5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding UsageCountLabel}" Foreground="{StaticResource TextSecondary}" FontSize="10.5" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                <Button Content="Rename" Click="Rename_Click" Style="{StaticResource ToolButton}"/>
                <Button Content="Duplicate" Click="Duplicate_Click" Style="{StaticResource ToolButton}"/>
                <Button Content="Change Color" Click="ChangeColor_Click" Style="{StaticResource ToolButton}"/>
                <Button Content="Change Shape" Click="ChangeShape_Click" Style="{StaticResource ToolButton}"/>
                <Button Content="Delete" Click="Delete_Click" Style="{StaticResource ToolButton}"/>
            </StackPanel>
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="Export Classes…" Click="Export_Click" Style="{StaticResource ToolButton}"/>
                    <Button Content="Import Classes…" Click="Import_Click" Style="{StaticResource ToolButton}"/>
                </StackPanel>
                <Button Content="Close" Click="Close_Click" Style="{StaticResource ToolButton}" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
