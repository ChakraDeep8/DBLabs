<Window x:Class="DBLabs.Views.SimpleChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose" Height="320" Width="280"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource AppBackground}" FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" Text="Choose" Foreground="{StaticResource TextPrimary}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <ListBox x:Name="OptionsList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource ObjectListItem}" Foreground="{StaticResource TextPrimary}"
                 MouseDoubleClick="OptionsList_MouseDoubleClick"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="80" Height="30" Margin="0,0,8,0" Click="Cancel_Click" Style="{StaticResource ToolButton}"/>
            <Button Content="OK" Width="80" Height="30" Click="Ok_Click" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
