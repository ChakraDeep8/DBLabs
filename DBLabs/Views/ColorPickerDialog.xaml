<Window x:Class="DBLabs.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose Color" Height="300" Width="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource AppBackground}" FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Choose Color" Foreground="{StaticResource TextPrimary}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <ItemsControl x:Name="SwatchGrid" Grid.Row="1" Margin="0,0,0,14">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <TextBlock Grid.Row="2" Text="Custom hex (e.g. #4C8DFF)" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,4"/>
        <TextBox x:Name="HexBox" Grid.Row="3" Style="{StaticResource InputBox}"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="80" Height="30" Margin="0,0,8,0" Click="Cancel_Click" Style="{StaticResource ToolButton}"/>
            <Button Content="OK" Width="80" Height="30" Click="Ok_Click" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
